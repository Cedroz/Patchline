# Copy to .env and fill in. Never commit .env.
# With USE_MOCKS=1 everything runs offline; each service can also be switched individually.
USE_MOCKS=1

# Orchestrator
PORT=8787
PUBLIC_URL=http://localhost:8787          # what the game / Forge app use to reach the orchestrator (tunnel URL in demo)
DASHBOARD_URL=http://localhost:5173
GAME_REPO_PATH=../hop-runner             # local clone of the demo game repo (bisect + fixes run here)
GAME_REPO_PUSH=0                          # 1 = git push origin main after an approved merge (triggers Vercel)
GAME_LIVE_URL=                            # deployed game, e.g. https://hop-runner.vercel.app
AUTO_AGENT_FIXABLE=1                      # demo: auto-add the agent-fixable label once a culprit is found

# Anthropic (triage, repro drafting, breaker tests, voice brief)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
MOCK_CLAUDE=

# Factory Droid SDK (fix agent). Needs the `droid` CLI on PATH.
FACTORY_API_KEY=
FIX_AGENT=droid                           # droid | claude | mock
DROID_EXEC_PATH=                          # optional; Windows auto-detects the native droid.exe
MOCK_DROID=

# Jira Cloud (demo site from `forge site provision`)
JIRA_BASE_URL=https://your-site.atlassian.net
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=PATCH
MOCK_JIRA=
FORGE_WEBHOOK_SECRET=change-me            # shared secret the Forge trigger sends in x-patchline-secret

# SpacetimeDB
SPACETIME_URI=ws://localhost:3000
SPACETIME_DB=patchline
MOCK_SPACETIME=

# Discord bot
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=                       # #bug-reports
MOCK_DISCORD=

# Cartesia (voice)
CARTESIA_API_KEY=
CARTESIA_VOICE_ID=
CARTESIA_MODEL=sonic-3.6
MOCK_CARTESIA=

# Apify (Steam / Reddit showcase)
APIFY_TOKEN=
APIFY_STEAM_ACTOR=
APIFY_REDDIT_ACTOR=
SHOWCASE_STEAM_APP_ID=                    # a popular indie game's Steam app id
SHOWCASE_SUBREDDIT=                       # its subreddit name, no r/
SHOWCASE_REDDIT_KEYWORDS=                 # optional, comma-separated, e.g. bug,crash,softlock
MOCK_APIFY=

# SpacetimeDB token (optional; otherwise a new identity is created at boot)
SPACETIME_TOKEN=
