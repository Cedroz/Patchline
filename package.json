{
  "name": "patchline",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "concurrently -n orch,dash,game -c cyan,magenta,yellow \"pnpm --filter @patchline/orchestrator dev\" \"pnpm --filter @patchline/dashboard dev\" \"pnpm dev:game\"",
    "dev:game": "node scripts/dev-game.mjs",
    "dev:orch": "pnpm --filter @patchline/orchestrator dev",
    "dev:dash": "pnpm --filter @patchline/dashboard dev",
    "seed:demo": "pnpm --filter @patchline/orchestrator seed:demo",
    "make-history": "node scripts/make-game-history.mjs",
    "fixtures": "pnpm --filter @patchline/orchestrator fixtures",
    "check:game": "pnpm --filter @patchline/orchestrator check:game",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "typescript": "^5.6.3"
  }
}
